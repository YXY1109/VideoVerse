# ==================== API 配置 ====================
# OpenAI 兼容 API 密钥
OPENAI_API_KEY=your_api_key_here
# OpenAI 兼容 API 端点
OPENAI_API_BASE=https://api.openai.com/v1
# OpenAI 兼容模型名称
OPENAI_MODEL=gpt-4o
# LLM 是否支持 JSON 模式输出 (true/false)
OPENAI_LLM_SUPPORT_JSON=true
# LLM 输出最大 token 数
OPENAI_MAX_TOKENS=16384

# ==================== ASR 配置 ====================
# Whisper 运行模式: local (本地模型) 或 api (302.ai API)
WHISPER_RUNTIME=local
# Whisper 模型名称 (local 模式)
WHISPER_MODEL=large-v3
# 识别语言: en, zh, ja, es, fr, de, it, ru 等
WHISPER_LANGUAGE=zh
# 302.ai API 密钥（api 模式）
WHISPERX_302_API_KEY=your_302_api_key_here
# ElevenLabs API 密钥（实验性）
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ==================== TTS 配置 ====================
# TTS 方法: azure, openai, edge, fish, gpt_sovits, cosyvoice, f5tts
TTS_METHOD=azure
# Azure TTS API 密钥（302.ai）
AZURE_TTS_API_KEY=YOUR_302_API_KEY
# Azure TTS 音色
AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# OpenAI TTS API 密钥
OPENAI_TTS_API_KEY=YOUR_302_API_KEY
# OpenAI TTS 音色
OPENAI_TTS_VOICE=alloy
# FishTTS API 密钥（302.ai）
FISH_TTS_API_KEY=YOUR_302_API_KEY
# SiliconFlow FishTTS API 密钥
SF_FISH_TTS_API_KEY=YOUR_API_KEY
# SiliconFlow CosyVoice2 API 密钥
SF_COSYVOICE2_API_KEY=YOUR_SF_KEY
# F5TTS API 密钥（302.ai）
F5TTS_302_API_KEY=YOUR_302_API_KEY
# Edge TTS 音色（免费，无需 API Key）
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ==================== 视频处理配置 ====================
# 目标语言: en, zh, ja, es, fr, de, it, ru 等
TARGET_LANGUAGE=en
# 是否使用 Demucs 进行人声分离 (true/false)
DEMUCS=true
# 是否烧录字幕到视频 (true/false)
BURN_SUBTITLES=true
# YouTube 视频下载分辨率: 360, 480, 720, 1080, 1440, 2160
YOUTUBE_RESOLUTION=1080
# FFmpeg 是否使用 GPU 加速 (true/false)
FFMPEG_GPU=true

# ==================== 字幕配置 ====================
# 字幕最大长度（字符数）
SUBTITLE_MAX_LENGTH=75
# 字幕目标时间倍数
SUBTITLE_TARGET_MULTIPLIER=1.2
# 最小字幕持续时间（秒）
MIN_SUBTITLE_DURATION=2.5
# 最小裁剪持续时间（秒）
MIN_TRIM_DURATION=3.5
# 时间戳容差（秒）
TOLERANCE=1.5

# ==================== 音频配置 ====================
# 最小速度倍数
SPEED_FACTOR_MIN=1.0
# 可接受速度倍数
SPEED_FACTOR_ACCEPT=1.2
# 最大速度倍数
SPEED_FACTOR_MAX=1.4

# ==================== 高级配置 ====================
# 最大并发工作线程数
MAX_WORKERS=10
# 最大分割长度
MAX_SPLIT_LENGTH=20
# 摘要长度（字符数）
SUMMARY_LENGTH=8000
# 是否启用反思翻译 (true/false)
REFLECT_TRANSLATE=false
# 模型缓存目录
MODEL_CACHE_DIR=_model_cache
# 翻译前是否暂停 (true/false)
PAUSE_BEFORE_TRANSLATE=false